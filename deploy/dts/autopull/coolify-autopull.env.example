# Copy to /etc/coolify-autopull.env (root:root, mode 0600). It holds a Coolify
# API token, so it must not be world-readable.

# The images Coolify's compose pulls as :latest. MinIO is pinned to a release
# tag, so it is not watched here.
AUTOPULL_IMAGES="ghcr.io/<owner>/contract-toaster-dts-backend:latest ghcr.io/<owner>/contract-toaster-dts-frontend:latest"

# The last path segment of the service's own page in the Coolify UI.
COOLIFY_SERVICE_UUID=<service-uuid>

# Coolify -> Keys & Tokens -> API tokens. Needs permission to deploy.
COOLIFY_API_TOKEN=<token>

# Coolify's own port on the box. Change only if Coolify listens elsewhere.
#COOLIFY_URL=http://127.0.0.1:8000

# The repository the images are built from. A new image rolls out only when
# its org.opencontainers.image.revision is on this repository's main; leave it
# unset to skip that check.
AUTOPULL_GITHUB_REPO=<owner>/<repo>
# Optional: a read-only token for that check, for a private repository or to
# lift the unauthenticated API rate limit.
#AUTOPULL_GITHUB_TOKEN=<token>

# How long a rollout may take to come up healthy before it is rolled back to
# the previous images. 0 turns verification and rollback off.
#AUTOPULL_VERIFY_SECONDS=420

# Optional: an Uptime Kuma push URL (Add monitor -> Push). Every run reports
# up or down, and a run that never comes shows as a missed heartbeat.
#AUTOPULL_HEARTBEAT_URL=https://<uptime-kuma-host>/api/push/<push-token>

# Cosign signature check of each NEW digest: warn (default), enforce or off.
# warn reports a missing or failing check in the journal and rolls forward
# anyway; enforce refuses the rollout. Flip to enforce only once a signed digest
# is deployed and cosign is installed on this box:
# deploy/dts/README.md#signature-verification-cosign
#AUTOPULL_COSIGN=warn
# The signer to expect. Defaults to this repository's dts-image-publish.yml on
# main, derived from AUTOPULL_GITHUB_REPO above.
#AUTOPULL_COSIGN_IDENTITY_REGEXP=
#AUTOPULL_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
# A full path, when cosign is not on the service's PATH.
#AUTOPULL_COSIGN_BIN=cosign
