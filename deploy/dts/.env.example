# Copy to deploy/dts/.env and fill in. Used by docker-compose (--env-file).

# Required: secret used to sign demo session tokens (any long random string).
#   e.g. `openssl rand -hex 32`
DEMO_TOKEN_SECRET=change-me-to-a-long-random-string

# OPTIONAL. The stack runs the REAL review chain (MODEL_PROVIDER=openrouter in
# docker-compose.yml) — there is no mock fallback, so a review needs a working
# OpenRouter key from ONE of two places:
#
#   1. The admin UI — sign in as an admin, "Model & API key" tab. Stored in
#      DynamoDB, rotatable without a restart, and it OVERRIDES this variable.
#      Leave the line below blank to manage the key entirely that way.
#   2. This variable — the fallback used when no admin has set a key.
#
# With neither, every review lands in ERROR at stage=build_model_client.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
