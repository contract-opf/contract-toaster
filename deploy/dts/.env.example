# Copy to deploy/dts/.env and fill in. Used by docker-compose (--env-file).

# Required: secret that signs every sign-in session. The backend refuses to
# start if it is blank, shorter than 32 bytes, a placeholder, or one repeated
# character. Never reuse a value from documentation.
# generate: openssl rand -hex 32
DEMO_TOKEN_SECRET=

# OPTIONAL. The stack runs the REAL review chain (MODEL_PROVIDER=openrouter in
# docker-compose.yml) — there is no mock fallback, so a review needs a working
# OpenRouter key from ONE of two places:
#
#   1. The admin UI — sign in as an admin, "Model & API key" tab. Stored in
#      DynamoDB, rotatable without a restart, and it OVERRIDES this variable.
#      Leave the line below blank to manage the key entirely that way.
#   2. This variable — the fallback used when no admin has set a key.
#
# With neither, every review lands in ERROR at stage=build_model_client.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL. Per-service CPU ceilings, as a CFS quota per 100000 microsecond
# period (400000 = up to 4 CPUs; 0 = no limit; anything else must be at least
# 1000, so BACKEND_CPU_QUOTA=4 is NOT "4 CPUs" and the container will not
# start). The defaults are generous; do not set the backend's tight, it runs
# the review pipeline.
# See deploy/dts/README.md#container-cpu-limits
#BACKEND_CPU_QUOTA=400000
#FRONTEND_CPU_QUOTA=200000
#DYNAMODB_CPU_QUOTA=200000
#MINIO_CPU_QUOTA=200000
