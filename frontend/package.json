    "audit:focus": "node scripts/focus-audit.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:bundle": "node scripts/bundle-budget.mjs",
    "lint": "eslint .",
    "lint:baseline": "node scripts/eslint-baseline.mjs",
    "format": "prettier --write",
