# engine-strict (issue #112): make the `engines` block in package.json a
# hard requirement instead of an npm warning nobody reads. Both bounds are
# minimums (">="), so this does not pin dev machines to the exact node:20-slim
# / npm 10.8.2 the Docker build (deploy/dts/frontend.Dockerfile) uses — see
# docs/frontend-design-system.md §3.3 for why local npm intentionally runs
# ahead of that. The actual lockfile-drift detector, pinned to npm 10.8.2
# specifically, is the unconditional `npm ci --dry-run` step in
# scripts/check-frontend.sh.
engine-strict=true
